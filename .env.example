# ── Supabase Postgres ──────────────────────────────────────────────────────
# Both come from: Supabase dashboard → your project → Connect → ORM → Prisma
#
# Required on Vercel (Production + Preview) for login to work:
#   DATABASE_URL, DIRECT_URL (build/migrate), JWT_SECRET
#
# DATABASE_URL — pooled connection (Supavisor, port 6543). The running app uses
# this for every query. Append ?pgbouncer=true — the transaction pooler cannot
# use prepared statements.
DATABASE_URL=""

# DIRECT_URL — direct, unpooled connection (port 5432). ONLY the Prisma CLI
# uses this (via prisma.config.ts) for `prisma migrate dev` / `prisma db push`.
# Using the pooled URL here is the most common Prisma+Supabase migration failure.
# Also required at `vike build` / Vercel build time (prisma generate / migrate).
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.sblpzvvcmhclvxhmasjs.supabase.co:5432/postgres"

# Used to sign session JWTs (login). Use a long random string in production.
# MUST be set in Vercel Project Settings → Environment Variables (Preview + Production).
JWT_SECRET="replace-with-a-long-random-string"

NODE_ENV="development"
