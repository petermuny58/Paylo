# ── Supabase Postgres ──────────────────────────────────────────────────────
# Both come from: Supabase dashboard → your project → Connect → ORM → Prisma
#
# DATABASE_URL — the pooled connection (Supavisor, port 6543). The running
# app uses this for every normal query. Needs ?pgbouncer=true appended —
# that disables prepared statements, which the transaction pooler can't
# support.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — the direct, unpooled connection (port 5432). ONLY the Prisma
# CLI uses this, for `prisma migrate dev` / `prisma db push`. Using the
# pooled URL here instead is the #1 way people break their own migrations.
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"
PORT=4000
